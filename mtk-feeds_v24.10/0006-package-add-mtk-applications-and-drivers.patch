+
+    function Channel_onchange (ch) {
+        getBw(null, ch);
+    }
+
+    function Bw_onchange(bw, ch) {
+        var ch_val;
+
+        if (!ch){
+            var ch_o = document.getElementById('Channel');
+
+            if (ch_o)
+                ch_val = ch_o.value;
+            if (ch_val == "")
+                ch_val = "<%=cfgs.Channel%>";
+        } else {
+            ch_val = ch
+        }
+
+        get5G2nd80MhzChannelList(bw, ch_val);
+        getHTExtChannel(bw, ch_val);
