+    vif = dev and dev.vifs[vifname] or nil
+    vifidx = vif and vif.vifidx or nil
+end
+
+local cfgs = mtkwifi.load_profile(dev.profile)
+local diff = mtkwifi.diff_profile(dev.profile)
