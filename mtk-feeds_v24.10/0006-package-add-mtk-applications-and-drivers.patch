+int hostapd_get_rand(u8 *buf, size_t len)
+{
+	FILE *f;
+	size_t rc;
+
+	f = fopen("/dev/urandom", "r");
+	if (f == NULL) {
+		printf("Could not open /dev/urandom.\n");
+		return -1;
+	}
+
+	rc = fread(buf, 1, len, f);
+	if (rc != len)
+		printf("Unexpected fread fail!\n");
+	if (fclose(f) != 0)
+		printf("Unexpected fclose fail!\n");
+
+	return rc != len ? -1 : 0;
+}
