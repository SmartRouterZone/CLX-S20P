--- /dev/null
+++ b/package/mtk/applications/8021xd/src/ap/fils_aead.c
@@ -0,0 +1,473 @@
+#include "includes.h"
+#include "fils.h"
+
+#include "common.h"
+#include "sta_info.h"
+#include "rtdot1x.h"
