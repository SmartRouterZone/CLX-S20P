+function vifs_cfg_parm(parm)
+    local vifs_cfg_parms = {"AuthMode", "EncrypType", "Key", "WPAPSK", "Access", "^WPS", "^wps", "^Wsc", "PIN", "^WEP", ";", "_"}
+    for _, pat in ipairs(vifs_cfg_parms) do
+        if string.find(parm, pat) then
+            return false
+        end
+    end
+    return true
