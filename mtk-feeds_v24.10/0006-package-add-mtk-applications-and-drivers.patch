+                    apcli_pmf_pc_cbox.checked = false;
+                    apcli_pmf_pr_cbox.checked = false;
+                    apcli_pmf_256sha_cbox.checked = false;
+                }
+                for (var idx=0; idx < wpa_enc_type_sel.length; idx++) {
+                    if( wpa_enc_type_sel.options[idx].value == "AES" ||
