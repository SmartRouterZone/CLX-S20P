+	else if (mcs == TMI_TX_RATE_CCK_2M_LP)
+		ret = 1;
+	else if (mcs == TMI_TX_RATE_CCK_5M_LP)
+		ret = 2;
+	else if (mcs == TMI_TX_RATE_CCK_11M_LP)
