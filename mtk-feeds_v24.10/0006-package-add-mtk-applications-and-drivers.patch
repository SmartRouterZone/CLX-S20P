+	SEC_AKM_MAX /* Not a real mode, defined as upper bound */
+} SEC_AKM_MODE;
+
+#define IS_AKM_OPEN(_AKMMap)                           ((_AKMMap & (1 << SEC_AKM_OPEN)) > 0)
