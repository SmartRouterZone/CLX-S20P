+    devname, vifname = request[5], request[6]
+    dev = devs and devs[devname]
+    vifname = vifname..#dev.vifs
+    vifidx = #dev.vifs + 1
+
+elseif request[4] == "vif_cfg_view" then
+    devname, vifname = request[5], request[6]
