+  CATEGORY:=MTK Properties
+  TITLE:=mtk hqos utility
+  VERSION:=$(PKG_RELEASE)-$(REVISION)
+  SUBMENU:=Applications
+endef
+
+define Package/mtkhqos_util/description
+  mtk hqos util
+endef
+
+define Build/Prepare
+	mkdir -p $(PKG_BUILD_DIR)
+endef
