+static INT32 getLegacyOFDMMCSIndex(UINT8 MCS)
+{
+	INT32 mcs_index = MCS;
+
+	if (MCS == 0xb)
+		mcs_index = 0;
+	else if (MCS == 0xf)
+		mcs_index = 1;
+	else if (MCS == 0xa)
+		mcs_index = 2;
+	else if (MCS == 0xe)
+		mcs_index = 3;
+	else if (MCS == 0x9)
+		mcs_index = 4;
+	else if (MCS == 0xd)
+		mcs_index = 5;
+	else if (MCS == 0x8)
+		mcs_index = 6;
+	else if (MCS == 0xc)
+		mcs_index = 7;
+
+	return mcs_index;
+}
