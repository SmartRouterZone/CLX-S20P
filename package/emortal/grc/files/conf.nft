regexp=^\s*(table|chain)\s+(ip|ip6|inet|arp|bridge|netdev)\s+(\S+)
colours=bold yellow,cyan,bold bright_blue
-
regexp=^\s*(ip6?|meta|ether|vlan|ct|tcp|udp|icmp|icmpv6|counter)\b
colours=bold cyan
-
regexp=\b(type|hook|priority|policy)\s+([^;]+)
colours=bold cyan,bold yellow
-
regexp=\b(accept|drop|reject|queue|return)\b
colours=bright_green,bright_red,red,on_red white,on_green white
-
regexp=\b(counter|packets|bytes)\b\s*(\d+)?
colours=bold magenta,bright_white
-
regexp=\b(tcp|udp|icmp|icmpv6|esp|ah|sctp)\b
colours=bold cyan
-
regexp=\b(ip|ip6|ether|vlan|ct|meta|payload|limit|log|snat|dnat|masquerade)\b
colours=yellow
-
regexp=\b((?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?)\b
colours=bright_white,magenta
-
regexp=(?<![0-9a-fA-F:])(?=[0-9a-fA-F:]*:[0-9a-fA-F:]*:)[0-9a-fA-F:]+/\d{1,3}(?![0-9a-fA-F:])
colours=magenta
-
regexp=\b(dport|sport)\s+(\{[^}]*\}|[0-9]+(?:-[0-9]+)?)
colours=default,bold yellow,bold yellow
